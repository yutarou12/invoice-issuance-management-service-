# 16文字以上。初回ブラウザ認証のユーザー名は admin。
APP_PASSWORD=change-this-to-a-long-random-password
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# nginxの公開先。LAN/VPN経由の場合はホストのLAN/VPN IPへ変更。
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
# ホスト側の設定ファイルと証明書ディレクトリ（絶対パスも指定可能）。
NGINX_CONF_PATH=./nginx/default.conf
TLS_CERTS_DIR=./certs
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASSWORD=
SMTP_FROM=
